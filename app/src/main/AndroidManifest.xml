<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ (API 30+) package-visibility: without declaring these,
         the app cannot see/bind to the on-device TextToSpeech engine or
         SpeechRecognizer service even when one is installed — TextToSpeech
         init silently reports ERROR and SpeechRecognizer.isRecognitionAvailable()
         silently returns false, with no exception and no user-facing error.
         This is the root cause of "TTS/voice কাজ করছে না" on API 30+ devices
         (targetSdk 34 here, well past the threshold). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- AdMob's SDK needs to see the Play Store app to open ads that
             deep-link out to it (e.g. "install this app" reward ads). -->
        <package android:name="com.android.vending" />
        <!-- Android 11+ package visibility: without this, packageManager can
             not see other apps at all, so "open WhatsApp" always failed
             silently (getLaunchIntentForPackage returned null). Listing
             every launcher activity needs no QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v43: Lenspilot AI Browser — সাইটের ক্যামেরা/লোকেশন অনুরোধ (ইউজার অনুমতি দিলে), পুরনো ফোনে ডাউনলোড -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lets the accessibility-stuck dialog jump the user straight to the
         "ignore battery optimizations" prompt for this app, instead of
         only pointing them at generic phone Settings — OEM battery
         restrictions (Xiaomi/Vivo/Oppo/Realme) are the #1 cause of
         Settings-says-ON-but-not-connected, see MainActivity's
         showAccessibilityNotRespondingDialog(). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Tier 2/3 fallback path (Accessibility not enabled): capturing a
         screenshot needs MediaProjection, and drawing the highlight
         overlay on top of other apps needs SYSTEM_ALERT_WINDOW — the
         non-accessibility route trades one permission for two others,
         it isn't permission-free (see onboarding copy in strings.xml). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Tools সেশন ৪: Runner (dataSync সার্ভিস) ও Scheduler (সঠিক অ্যালার্ম, রিবুটে পুনঃ-arm) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AI ব্রাউজার v2: রান চলাকালীন CPU জাগিয়ে রাখা (BrowserAgentService) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- v32 অটোমেশন মোড: ESP32-র Access Point-এর WiFi-তে কানেক্ট (WifiNetworkSpecifier) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- AI Automation: ব্লুটুথ (SPP) ও OTG (USB সিরিয়াল) দিয়ে ESP32 কানেক্ট -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <!-- v37: ফোনে অ্যাক্সেস পয়েন্ট (Local-Only Hotspot) বানিয়ে ESP32 চালানো — Android 13+-এ NEARBY_WIFI_DEVICES, তার নিচে লোকেশন -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".LenspilotApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Lenspilot"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- AdMob app id — required once anywhere in the manifest for the
             SDK to initialize at all (separate from the per-ad-unit id used
             when actually loading a rewarded ad, see reward_ad_unit_id). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7007962993307475~4149490347" />

        <!-- Start.io App ID — second rewarded-ad network. Which network is
             actually used is decided at runtime by the server
             (/api/ads/network, admin-panel switchable — see
             ads/AdNetworkManager.kt); both SDKs are simply always
             available in the APK, this ID just tells the Start.io SDK
             which registered app it's serving ads for. -->
        <meta-data
            android:name="com.startapp.sdk.APPLICATION_ID"
            android:value="208622167" />

        <!-- v31: তৈরি-হওয়া ক্লাস ভিডিও/PDF নোট খোলা ও শেয়ার করার জন্য (learning/MediaExport.kt) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Lenspilot.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Lightweight in-app AI browser (see feature note above
             LenspilotAccessibilityService): the app's OWN WebView, so JS
             injection can read/act on the DOM directly with NO
             Accessibility permission involved. Only ever opened when the
             browser-mode toggle next to the chat input was on for that
             run — user can flip its own AI switch off any time to browse
             it manually instead. -->
        <activity
            android:name=".browser.AiBrowserActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot"
            android:configChanges="orientation|screenSize|keyboardHidden" />


        <!-- AI ব্রাউজার v2 রান-সার্ভিস: foreground + WakeLock, দেখো browser/BrowserAgentService.kt -->
        <service
            android:name=".browser.BrowserAgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ai_browser_task_runner" />
        </service>



        <!-- ফ্রিমিয়াম প্রোমো স্ক্রিন + গাইডেড API-key সেটআপ এন্ট্রি পয়েন্ট।
             দেখো freemium/FreemiumActivity.kt। -->
        <activity
            android:name=".freemium.FreemiumActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot" />

        <!-- ফ্রিমিয়াম গাইড ওভারলে — Chrome-এর ওপর ভাসমান instruction bubble +
             deterministic (নন-LLM) স্টেপ ইঞ্জিনের ক্লায়েন্ট লুপ। বিদ্যমান
             ScreenCaptureService (MediaProjection) আর TextOcr পুনর্ব্যবহার
             করে — নতুন কোনো capture pipeline বানায়নি। দেখো
             freemium/FreemiumGuideOverlayService.kt। -->
        <service
            android:name=".freemium.FreemiumGuideOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="freemium_api_key_setup_guidance" />
        </service>

        <!-- AI Learning Mode — full-screen teaching UI (Gemini pipeline):
             synced typing+speech, spoken-only explanation segments, and
             matplotlib diagrams with a highlighter overlay. See
             /api/learning/lesson in app.py. -->
        <activity
            android:name=".learning.LearningModeActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.Learning"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- লার্নিং লাইব্রেরি: কোর্স/অধ্যায়/বিষয়/ক্লাস → প্লেলিস্ট (LearningLibraryActivity) -->
        <activity
            android:name=".learning.LearningLibraryActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.LearningLight" />

        <!-- ম্যানুয়াল সিলেবাস/পাঠ/সূচিপত্র (লিখে বা ছবি দিয়ে) → ইউজারের নিজস্ব RAG; লাইব্রেরির হোম থেকে খোলে -->
        <activity
            android:name=".learning.SyllabusActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Lenspilot.LearningLight" />

        <!-- Tools মোড (ELORA) — Learning Mode-এর পাশের বাটন থেকে খোলে (MainActivity.openToolsMode)।
             স্পেক: lp/TOOLS_MODE_SPEC.md -->
        <activity
            android:name=".tools.ToolsModeActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.Tools"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".tools.StorageActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.Tools"
            android:windowSoftInputMode="adjustResize" />
        <!-- Tools মোড সেশন ৩: নিরাপত্তা স্ক্রিন ও অনুমোদন রিসিভার -->
        <activity
            android:name=".tools.perm.ToolsSecurityActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.Tools" />
        <receiver
            android:name=".tools.perm.PermissionReceiver"
            android:exported="false" />
        <service
            android:name=".tools.runner.RunnerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".tools.runner.ScheduleReceiver"
            android:exported="false" />
        <receiver
            android:name=".tools.runner.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- সেশন ৭: লাইভ কাজের স্ক্রিন (নোটিফিকেশন-ট্যাপের ডিপ-লিংকও এখানে) -->
        <activity
            android:name=".tools.agent.ToolsSessionActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Lenspilot.Tools"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".tools.SessionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.Tools" />
        <!-- Tools মোড সেশন ২: শেল (Git/JGit) -->
        <activity
            android:name=".tools.shell.ShellActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.Shell"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- v32: AI Automation of the Real World — সার্চ/ডাউনলোড (Hub), এজেন্ট পেজ, ESP32 কন্ট্রোল (WebView) -->
        <activity
            android:name=".automation.AutomationHubActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.Auto"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".automation.AgentActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.Auto"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".automation.DeviceConsoleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Lenspilot.Auto"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- মাল্টি-এজেন্ট মোডের "Resources" পেজ — উত্তরের নিচের Resources বাটন থেকে খোলে
             (MainActivity.openMultiAgentResources): দুই AI কোন কোন ওয়েবে সার্চ করেছে আর
             তাদের নিজের নিজের উত্তর। -->
        <activity
            android:name=".multiagent.MultiAgentResourcesActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Full-screen "watch more / get more tokens" break page shown
             right after each rewarded ad finishes (see ads/AdBreakActivity). -->
        <activity
            android:name=".ads.AdBreakActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot" />

        <!-- Quick Settings tile trampoline (API < 34 only — collapseStatusBar()
             covers 34+ directly). Invisible, excluded from recents/task
             switcher, no launcher entry — its only purpose is closing the
             QS shade before the tile's screen scan runs. See class kdoc. -->
        <activity
            android:name=".QuickScanTrampolineActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.Invisible"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />

        <!-- Invisible trampoline so a Service (which can't launch an image
             picker itself) can still let the user attach a picture to a
             mid-workflow message — see PendingImagePick.kt. -->
        <activity
            android:name=".ImagePickTrampolineActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.Invisible"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />

        <!-- v60: স্ক্রিন-ক্যাপচার অনুমতির অদৃশ্য ট্রাম্পোলিন (Accessibility ছাড়া বাবল এজেন্ট/Guide/Scan) — ScreenCaptureTrampolineActivity.kt -->
        <activity
            android:name=".ScreenCaptureTrampolineActivity"
            android:exported="false"
            android:theme="@style/Theme.Lenspilot.Invisible"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />

        <!-- TIER 1 screen-reading + highlight overlay. The user must turn
             this on manually from Android Settings -> Accessibility; apps
             cannot self-enable it (OS-level protection). -->
        <service
            android:name=".accessibility.LenspilotAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="accessibility_session_must_survive_backgrounding" />
        </service>

        <!-- TIER 2 fallback (no Accessibility): hosts the MediaProjection
             session used to grab a screenshot for ML Kit OCR. Android
             requires a visible notification and a
             declared foregroundServiceType while a MediaProjection is
             active — this is an OS-level disclosure requirement, not
             optional, so the user always knows capture is happening. -->
        <service
            android:name=".vision.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Hosts the workflow loop + overlay UI (control bar, trigger
             bubble, highlight rendering) when Accessibility is off —
             the Tier 2/3 counterpart of LenspilotAccessibilityService.
             No special foregroundServiceType needed here (it doesn't
             itself touch MediaProjection or the mic continuously — that's
             ScreenCaptureService's job; this one just orchestrates). -->
        <service
            android:name=".vision.FallbackGuideService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on_screen_guidance_without_accessibility" />
        </service>

        <!-- v52: ভাসমান AI এজেন্ট (বাবল + গ্লাস কার্ড) — শুধু Overlay পারমিশন লাগে, Accessibility ঐচ্ছিক -->
        <service
            android:name=".agent.AgentOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_ai_agent_chat_overlay" />
        </service>

        <!-- Lenspilot Keyboard — a NORMAL system input method (IME). Shows
             up under Settings -> System -> Languages & input -> On-screen
             keyboard, exactly like Gboard/SwiftKey. This is a completely
             separate permission model from LenspilotAccessibilityService
             above: the user enables it the same way they'd enable any
             third-party keyboard app, and Android itself is what stops any
             app (including this one) from self-activating it — there is no
             Accessibility permission involved anywhere in this feature. -->
        <service
            android:name=".keyboard.LenspilotInputMethodService"
            android:exported="true"
            android:label="@string/keyboard_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Quick Settings tile — the shortcut in the pull-down shade
             (next to Wi-Fi/data) that scans the current screen directly,
             without opening the app. -->
        <service
            android:name=".QuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
