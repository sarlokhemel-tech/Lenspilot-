<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Lenspilot" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_action</item>
        <item name="colorPrimaryDark">@color/background_light</item>
        <item name="colorAccent">@color/navigation</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/background_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <!-- AI লার্নিং মোড: পুরো স্ক্রিন ডার্ক — আগে এই Activity-ও সাদা Theme.Lenspilot-এ চলত, তাই শুরুতে/
         ঘোরানোর সময় সাদা ঝলক আসত আর স্ট্যাটাস/নেভিগেশন বার সাদা থাকত। -->
    <style name="Theme.Lenspilot.Learning" parent="Theme.Lenspilot">
        <item name="android:windowBackground">@color/blackboard_bg</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/blackboard_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/blackboard_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- v37: অটোমেশন মোডের (হাব/এজেন্ট/কন্ট্রোল) হালকা প্রিমিয়াম থিম — ফোন ডার্ক মোডে থাকলেও এই স্ক্রিন ও তার ডায়ালগ সবসময় হালকা
         (AutoUi-র গাঢ় লেখা যেন গাঢ় ডায়ালগে হারিয়ে না যায়)। -->
    <style name="Theme.Lenspilot.Auto" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#1E6BFF</item>
        <item name="colorAccent">#1E6BFF</item>
        <item name="android:windowBackground">#F4F6FB</item>
        <item name="android:statusBarColor" tools:targetApi="21">#F4F6FB</item>
        <item name="android:navigationBarColor" tools:targetApi="21">#F4F6FB</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <style name="Theme.Lenspilot.Splash" parent="Theme.Lenspilot">
        <item name="android:windowBackground">#FFFFFF</item>
    </style>

    <!-- Used only by QuickScanTrampolineActivity — a real Activity is the
         one thing that reliably collapses the Quick Settings shade on
         every Android version (startActivityAndCollapse), but it must be
         fully invisible since its only job is to close the panel and
         trigger the scan a moment later. -->
    <style name="Theme.Lenspilot.Invisible" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>


    <!-- লাইভ চ্যাট: ফুল-স্ক্রিন, স্বচ্ছ উইন্ডো — পেছনের ব্রাউজার দেখা যায় -->
    <style name="Theme.Lenspilot.LiveChatGlass" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
