<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- ===================== SIGN-IN SCREEN ===================== -->
    <LinearLayout
        android:id="@+id/signInSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/ic_lenspilot_logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/signin_prompt"
            android:textColor="@color/text_primary_light"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/signin_subtitle"
            android:textColor="@color/text_secondary_light"
            android:textSize="14sp"
            android:gravity="center" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/signInButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:paddingStart="16dp"
            android:paddingEnd="24dp"
            android:background="@drawable/bg_button_google"
            android:text="@string/signin_with_google"
            android:textColor="#3C4043"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:drawableStart="@drawable/ic_google_logo"
            android:drawablePadding="12dp"
            android:elevation="1dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- ===================== CHAT SCREEN ===================== -->
    <LinearLayout
        android:id="@+id/chatSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top bar: history | title | new-chat | profile -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/historyButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_history"
                android:contentDescription="@string/chat_history_title" />

            <!-- Icon-only shortcut for "app খুললেই ভয়েস কমান্ড" — no label,
                 just a button, right at the top of the app, so it doesn't
                 need to live inside the Settings dialog anymore. Tapping
                 toggles the setting AND, when turning it on, jumps
                 straight into the voice-first ball immediately. -->
            <ImageButton
                android:id="@+id/voiceFirstToggleButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/historyButton"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_mic"
                android:contentDescription="অ্যাপ খুললেই ভয়েস কমান্ড" />

            <!-- Lenspilot Keyboard mode — opens dialog_keyboard_mode, a
                 normal system IME toggle, no Accessibility involved. -->
            <ImageButton
                android:id="@+id/keyboardModeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/voiceFirstToggleButton"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_keyboard"
                android:contentDescription="@string/cd_keyboard_mode_button" />

            <!-- Master OFF: one tap that force-stops every running
                 process (workflow, overlays, control bar, TTS, mic) even
                 if a workflow finished but left something stuck on
                 screen. Replaces the old plain "Lenspilot" title label —
                 the app name is already shown on the history screen, so
                 this spot is more useful as an always-available kill
                 switch. -->
            <ImageButton
                android:id="@+id/masterOffButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_power_off"
                app:tint="@color/danger_destructive"
                android:contentDescription="@string/cd_master_off" />

            <!-- The old always-on "আমার তথ্য" header button (userInfoButton)
                 is gone — that sent its saved table with EVERY request,
                 everywhere, forever. Per-run data now lives as a small
                 icon next to each individual Run button instead (see
                 item_workflow_card.xml / item_ela_run_button.xml +
                 MainActivity.showOneTimeUserInfoDialog), so info only
                 ever rides along with the one run it was attached to. -->
            <ImageButton
                android:id="@+id/speakButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/newChatButton"
                android:background="@drawable/bg_circle_icon"
                android:padding="7dp"
                android:src="@drawable/ic_speaker"
                android:contentDescription="Speak reply" />

            <ImageButton
                android:id="@+id/newChatButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/profileButton"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_add"
                android:contentDescription="@string/chat_new_chat" />

            <ImageButton
                android:id="@+id/profileButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_profile"
                android:contentDescription="Profile" />
        </RelativeLayout>

        <!-- Token bar: current input/output balance + "get tokens" icon.
             See com.hemel.lenspilot.ads (TokenWallet, RewardedAdManager,
             AdBreakActivity) for the ad-reward economy behind this. -->
        <LinearLayout
            android:id="@+id/tokenBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/tokenInfoCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_workflow_card"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/tokenInputText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ইনপুট: —"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tokenDivider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="•"
                    android:textColor="@color/border_light" />

                <TextView
                    android:id="@+id/tokenOutputText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="আউটপুট: —"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp">

                <ImageButton
                    android:id="@+id/getTokensButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="7dp"
                    android:src="@drawable/ic_token"
                    android:contentDescription="@string/get_tokens_button" />

                <View
                    android:id="@+id/tokenLowDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_red_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- NOTE: the old speak/mic/stop control ROW that used to live
             here has been removed on purpose — those 3 icons now only
             ever appear as the floating overlay control bar (see
             overlay_control_bar.xml), and only while a workflow is
             actually running on-screen, outside the app. Regular voice
             dictation for composing a chat message lives in the input
             row below (micButton) instead, unchanged behavior. -->

        <TextView
            android:id="@+id/voiceStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

        <!-- Accessibility onboarding banner -->
        <LinearLayout
            android:id="@+id/accessibilityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_workflow_card"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workflow_need_accessibility"
                android:textColor="@color/text_primary_light"
                android:textSize="13sp" />

            <Button
                android:id="@+id/enableAccessibilityButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_secondary"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Enable"
                android:textAllCaps="false"
                android:textColor="@color/text_primary_light" />
        </LinearLayout>

        <!-- AI Browser মোড: অটোমেশন-ব্রাউজারের অ্যাড্রেস-বার (MainActivity.applyBrowserModeUi)। মোড বন্ধে gone। -->
        <LinearLayout
            android:id="@+id/browserChrome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_browser_address"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:visibility="gone">
            <!-- v28: হ্যাকার-ধাঁচের "ai-browser://" ঠিকানা-বার সরিয়ে লার্নিং মোডের রোবট + শান্ত শিরোনাম -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/robot_happy_front"
                android:contentDescription="Lenspilot robot" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI ব্রাউজার"
                    android:textColor="@color/browser_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="তুমি বলো, আমি ওয়েবে করে দিচ্ছি"
                    android:textColor="@color/browser_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chat messages + empty state -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/emptyStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/chat_empty_state"
                android:textColor="@color/text_muted_light"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- FEATURE ("লার্নিং মোড চালু করলে পুরো স্ক্রিনে ডার্ক থিম, মনে হবে অন্য কোথাও চলে এসেছি"):
                 লার্নিং মোড অন থাকলে চ্যাট তালিকার ওপর এই ব্ল্যাকবোর্ড-স্টাইল লেয়ার আসে (MainActivity.
                 applyLearningModeUi) — সাথে পুরো পেজ/স্ট্যাটাস বার/টপ বার ডার্ক হয়ে যায়। চ্যাট নিচে যেমন
                 ছিল তেমনই থাকে; মোড বন্ধ করলেই ফিরে আসে। -->
            <ScrollView
                android:id="@+id/learningVibeLayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/blackboard_bg"
                android:fillViewport="true"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/learningVibeRobot"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:src="@drawable/robot_happy_front"
                        android:contentDescription="Lenspilot robot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="AI Learning Mode"
                        android:textColor="@color/chalk_white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="What would you like to learn today?"
                        android:textColor="@color/chalk_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/learningChip1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_blackboard_input"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="How does photosynthesis work?"
                        android:textColor="@color/chalk_white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/learningChip2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_blackboard_input"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="Explain Newton's laws of motion"
                        android:textColor="@color/chalk_white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/learningChip3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_blackboard_input"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="The Pythagorean theorem"
                        android:textColor="@color/chalk_white"
                        android:textSize="13sp" />

                    <!-- v25: লার্নিং লাইব্রেরি — কোর্স / অধ্যায় / বিষয় / ক্লাস → পরিকল্পনা ও প্লেলিস্ট -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:text="📚 পরিকল্পনা করে শিখুন"
                        android:textColor="@color/chalk_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="AI অনলাইনে খুঁজে প্লেলিস্ট বানাবে — পড়া শেষ হলে ✓ দিন"
                        android:textColor="@color/chalk_muted"
                        android:textSize="12sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/learningLibCourse"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_blackboard_input"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="📚\nকোর্স"
                            android:textColor="@color/chalk_white"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/learningLibChapter"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_blackboard_input"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="📖\nঅধ্যায়"
                            android:textColor="@color/chalk_white"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/learningLibSubject"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_blackboard_input"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="🧪\nবিষয়"
                            android:textColor="@color/chalk_white"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/learningLibClass"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_blackboard_input"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="🏫\nক্লাস"
                            android:textColor="@color/chalk_white"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/learningLibOpen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_blackboard_input"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="▶ আমার প্লেলিস্ট"
                        android:textColor="@color/chalk_white"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/learningDetailLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/chalk_muted"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/learningDetailSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="9" />
                </LinearLayout>
            </ScrollView>

            <!-- AI Browser মোডের হিরো (চ্যাট খালি থাকলে) — লার্নিং-ভাইবের মতোই, কিন্তু ব্রাউজার-থিমের -->
            <ScrollView
                android:id="@+id/browserVibeLayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/browser_bg"
                android:fillViewport="true"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">
                    <!-- Lenspilot robot (same one as Learning Mode) sitting in front of a browser window
                         = "the robot drives the browser". Shown only while the chat is empty. -->
                    <FrameLayout
                        android:layout_width="240dp"
                        android:layout_height="190dp">
                        <ImageView
                            android:layout_width="240dp"
                            android:layout_height="170dp"
                            android:layout_gravity="top|center_horizontal"
                            android:src="@drawable/ic_browser_window_art"
                            android:contentDescription="Browser window" />
                        <ImageView
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="14dp"
                            android:src="@drawable/robot_explaining_right"
                            android:contentDescription="Lenspilot robot" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Web Autopilot"
                        android:textColor="@color/browser_text"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="Describe the goal. I\u2019ll open the sites, click, type and fill the forms \u2014 you just watch it happen."
                        android:textColor="@color/browser_muted"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_browser_button"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="Goal  →  Details  →  Run"
                        android:textColor="@color/browser_accent"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Screenshot attachment preview (Gemini-style "+" chip) — shown
             only while an image is staged to go out with the next message. -->
        <LinearLayout
            android:id="@+id/attachmentPreviewRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/attachmentThumbnail"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_input_field"
                    android:contentDescription="Attached screenshot" />

                <ImageButton
                    android:id="@+id/attachmentRemoveButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_close_chip"
                    android:padding="3dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Remove attachment" />
            </FrameLayout>
        </LinearLayout>

        <!-- Input row: attach (+) | text | mic (dictate) | send.
             NOTE: toolbar icons are 32dp (were 34dp) so the new multi-agent button
             fits on 360dp-wide phones without pushing mic/send off screen. -->
        <!-- AI Browser মোডের নিচের বক্স: ডেটাবেজ লেখা + ছবি/ডকুমেন্ট থেকে তথ্য। শুধু এই রানের জন্য
             (Run চাপলে AI ব্রাউজারের অনুরোধে user_info হয়ে যায়)। -->
        <LinearLayout
            android:id="@+id/browserBottomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_browser_panel"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="এই কাজের তথ্য"
                    android:textColor="@color/browser_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/browserDbCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_browser_button"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="0 টি"
                    android:textColor="@color/browser_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/browserDbInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_browser_address"
                android:gravity="top|start"
                android:hint="প্রতি লাইনে একটা তথ্য — যেমন: নাম: রহিম"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:minLines="2"
                android:padding="10dp"
                android:textColor="@color/browser_text"
                android:textColorHint="@color/browser_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/browserDbStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/browser_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/browserDbSaveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_browser_button"
                    android:gravity="center"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="যোগ করুন"
                    android:textColor="@color/browser_accent"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/browserDbPhotoButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_browser_button"
                    android:gravity="center"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="ছবি থেকে নিন"
                    android:textColor="@color/browser_accent"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/browserDbViewButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_browser_button"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="তালিকা"
                    android:textColor="@color/browser_accent"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/browserVaultButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_browser_button"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="ভল্ট"
                    android:textColor="@color/browser_accent"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Claude/Gemini-style composer: full-width text box on top,
             compact tool icons in their own row underneath — the old
             single horizontal row (5 icons + EditText all side by side)
             squeezed the writing area down to almost nothing on regular
             phone widths. Same view ids as before, so MainActivity's
             click listeners/logic need no changes. -->
        <LinearLayout
            android:id="@+id/composerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input_field"
            android:padding="6dp">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="4dp"
                android:minHeight="40dp"
                android:background="@android:color/transparent"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:gravity="center_vertical"
                android:hint="@string/chat_input_hint"
                android:textColor="@color/text_primary_light"
                android:textColorHint="@color/text_muted_light"
                android:textSize="15sp"
                android:maxLines="6"
                android:scrollbars="vertical"
                android:inputType="textMultiLine|textCapSentences" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <ImageButton
                    android:id="@+id/attachButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_add"
                    android:contentDescription="সমস্যার স্ক্রিনশট যোগ করো" />

                <!-- System-switcher: which chat-box "brain" runs the next
                     workflow — "Lenspilot Super Lite" (big model plans once,
                     small model executes) vs "Lenspilot Super 1.2" (default;
                     fresh-brain-every-screen + target_label local match).
                     Tapping opens a small popup menu, mirroring Gemini's
                     model-switcher. Placed before browserModeButton per
                     spec ("ব্রাউজার সুইচিং অপসন এর আগে"). -->
                <ImageButton
                    android:id="@+id/systemModeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_steps_list"
                    android:contentDescription="সিস্টেম বাছাই — Super Lite / Super 1.2" />

                <!-- Browser-mode toggle: when ON, the workflow's Run step
                     executes inside the in-app AI browser instead of the
                     normal on-screen highlight guide. -->
                <ImageButton
                    android:id="@+id/browserModeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_browser_ai"
                    android:contentDescription="AI ব্রাউজার মোড" />

                <!-- AI Learning Mode: opens a full-screen teaching
                     experience (LearningModeActivity) instead of sending
                     a normal chat message — not a toggle like the two
                     buttons above, tapping it always launches the
                     screen directly. -->
                <ImageButton
                    android:id="@+id/learningModeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_learning_mode"
                    android:contentDescription="AI লার্নিং মোড" />

                <!-- Discussion-mode toggle (sibling of browser mode, same
                     spot): when ON, messages still get answered —
                     database search first if relevant, otherwise a
                     normal reply — but the server never turns the reply
                     into an actual workflow card, only a suggestion. -->
                <ImageButton
                    android:id="@+id/discussionModeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_discussion"
                    android:contentDescription="@string/cd_discussion_mode" />

                <!-- FEATURE ("নতুন মোড — মাল্টি-এজেন্ট"): লার্নিং মোডের পাশে, Tools বাটনের ঠিক আগে
                     (সবার শেষে থাকে Tools)। টগল: অন থাকলে পাঠানো মেসেজ দুই AI (Gemini 3.8 Flash +
                     Groq GPT-OSS 120B) একসাথে ওয়েবে সার্চ করে উত্তর দেয়, তারপর চূড়ান্ত বিচারক
                     মিলিয়ে একটাই সবচেয়ে সঠিক উত্তর লেখে — দেখো MainActivity.toggleMultiAgentMode
                     ও app.py-র _workflow_plan_multi_agent। -->
                <ImageButton
                    android:id="@+id/multiAgentModeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_multi_agent"
                    android:contentDescription="@string/cd_multi_agent_mode" />

                <!-- FEATURE ("লার্নিং মোডের পাশেই Tools মোড"): লার্নিং মোডের
                     মতোই ফুল-স্ক্রিন, কিন্তু ভিডিও এডিটিংয়ের জন্য —
                     ToolsModeActivity ভিডিও আপলোড + free-form নির্দেশনা
                     নেয়। এখনো ডেমো (FFmpeg পরে যোগ হবে — দেখো
                     ToolsModeActivity-এর ক্লাস-কমেন্ট)। -->
                <ImageButton
                    android:id="@+id/toolsModeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_tools_mode"
                    android:contentDescription="Tools মোড (ভিডিও এডিট)" />

                <!-- v32: AI Automation of the Real World — Tools-এর ঠিক পরের (শেষ) আইকন। চ্যাট নয়: সম্পূর্ণ আলাদা
                     স্ক্রিন, শুধু সার্চ — দেখো automation/AutomationHubActivity। -->
                <ImageButton
                    android:id="@+id/automationModeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_automation_world"
                    android:contentDescription="AI Automation of the Real World" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/micButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Voice command" />

                <ImageButton
                    android:id="@+id/sendButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_icon_active"
                    android:padding="10dp"
                    android:src="@drawable/ic_send"
                    android:contentDescription="@string/chat_send" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include
        layout="@layout/overlay_voice_first"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
