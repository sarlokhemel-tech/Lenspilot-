<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- ===================== SIGN-IN SCREEN ===================== -->
    <LinearLayout
        android:id="@+id/signInSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/ic_lenspilot_logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/signin_prompt"
            android:textColor="@color/text_primary_light"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/signin_subtitle"
            android:textColor="@color/text_secondary_light"
            android:textSize="14sp"
            android:gravity="center" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/signInButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:paddingStart="16dp"
            android:paddingEnd="24dp"
            android:background="@drawable/bg_button_google"
            android:text="@string/signin_with_google"
            android:textColor="#3C4043"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:drawableStart="@drawable/ic_google_logo"
            android:drawablePadding="12dp"
            android:elevation="1dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- ===================== CHAT SCREEN ===================== -->
    <LinearLayout
        android:id="@+id/chatSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top bar: history | title | new-chat | profile -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/historyButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_history"
                android:contentDescription="@string/chat_history_title" />

            <!-- Icon-only shortcut for "app খুললেই ভয়েস কমান্ড" — no label,
                 just a button, right at the top of the app, so it doesn't
                 need to live inside the Settings dialog anymore. Tapping
                 toggles the setting AND, when turning it on, jumps
                 straight into the voice-first ball immediately. -->
            <ImageButton
                android:id="@+id/voiceFirstToggleButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/historyButton"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_mic"
                android:contentDescription="অ্যাপ খুললেই ভয়েস কমান্ড" />

            <!-- Lenspilot Keyboard mode — opens dialog_keyboard_mode, a
                 normal system IME toggle, no Accessibility involved. -->
            <ImageButton
                android:id="@+id/keyboardModeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/voiceFirstToggleButton"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_keyboard"
                android:contentDescription="@string/cd_keyboard_mode_button" />

            <!-- Master OFF: one tap that force-stops every running
                 process (workflow, overlays, control bar, TTS, mic) even
                 if a workflow finished but left something stuck on
                 screen. Replaces the old plain "Lenspilot" title label —
                 the app name is already shown on the history screen, so
                 this spot is more useful as an always-available kill
                 switch. -->
            <ImageButton
                android:id="@+id/masterOffButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_power_off"
                app:tint="@color/danger_destructive"
                android:contentDescription="@string/cd_master_off" />

            <ImageButton
                android:id="@+id/speakButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/newChatButton"
                android:background="@drawable/bg_circle_icon"
                android:padding="7dp"
                android:src="@drawable/ic_speaker"
                android:contentDescription="Speak reply" />

            <ImageButton
                android:id="@+id/newChatButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/profileButton"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_add"
                android:contentDescription="@string/chat_new_chat" />

            <ImageButton
                android:id="@+id/profileButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_circle_icon"
                android:padding="8dp"
                android:src="@drawable/ic_profile"
                android:contentDescription="Profile" />
        </RelativeLayout>

        <!-- Token bar: current input/output balance + "get tokens" icon.
             See com.hemel.lenspilot.ads (TokenWallet, RewardedAdManager,
             AdBreakActivity) for the ad-reward economy behind this. -->
        <LinearLayout
            android:id="@+id/tokenBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_workflow_card"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/tokenInputText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ইনপুট: —"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="•"
                    android:textColor="@color/border_light" />

                <TextView
                    android:id="@+id/tokenOutputText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="আউটপুট: —"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp">

                <ImageButton
                    android:id="@+id/getTokensButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="7dp"
                    android:src="@drawable/ic_token"
                    android:contentDescription="@string/get_tokens_button" />

                <View
                    android:id="@+id/tokenLowDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_red_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- NOTE: the old speak/mic/stop control ROW that used to live
             here has been removed on purpose — those 3 icons now only
             ever appear as the floating overlay control bar (see
             overlay_control_bar.xml), and only while a workflow is
             actually running on-screen, outside the app. Regular voice
             dictation for composing a chat message lives in the input
             row below (micButton) instead, unchanged behavior. -->

        <TextView
            android:id="@+id/voiceStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

        <!-- Accessibility onboarding banner -->
        <LinearLayout
            android:id="@+id/accessibilityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_workflow_card"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workflow_need_accessibility"
                android:textColor="@color/text_primary_light"
                android:textSize="13sp" />

            <Button
                android:id="@+id/enableAccessibilityButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_secondary"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Enable"
                android:textAllCaps="false"
                android:textColor="@color/text_primary_light" />
        </LinearLayout>

        <!-- Chat messages + empty state -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/emptyStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/chat_empty_state"
                android:textColor="@color/text_muted_light"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Screenshot attachment preview (Gemini-style "+" chip) — shown
             only while an image is staged to go out with the next message. -->
        <LinearLayout
            android:id="@+id/attachmentPreviewRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/attachmentThumbnail"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_input_field"
                    android:contentDescription="Attached screenshot" />

                <ImageButton
                    android:id="@+id/attachmentRemoveButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_close_chip"
                    android:padding="3dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Remove attachment" />
            </FrameLayout>
        </LinearLayout>

        <!-- Input row: attach (+) | text | mic (dictate) | send -->
        <!-- Claude/Gemini-style composer: full-width text box on top,
             compact tool icons in their own row underneath — the old
             single horizontal row (5 icons + EditText all side by side)
             squeezed the writing area down to almost nothing on regular
             phone widths. Same view ids as before, so MainActivity's
             click listeners/logic need no changes. -->
        <LinearLayout
            android:id="@+id/composerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input_field"
            android:padding="6dp">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="4dp"
                android:minHeight="40dp"
                android:background="@android:color/transparent"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:gravity="center_vertical"
                android:hint="@string/chat_input_hint"
                android:textColor="@color/text_primary_light"
                android:textColorHint="@color/text_muted_light"
                android:textSize="15sp"
                android:maxLines="6"
                android:scrollbars="vertical"
                android:inputType="textMultiLine|textCapSentences" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <ImageButton
                    android:id="@+id/attachButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="7dp"
                    android:src="@drawable/ic_add"
                    android:contentDescription="সমস্যার স্ক্রিনশট যোগ করো" />

                <!-- Browser-mode toggle: when ON, the workflow's Run step
                     executes inside the in-app AI browser instead of the
                     normal on-screen highlight guide. -->
                <ImageButton
                    android:id="@+id/browserModeButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="7dp"
                    android:src="@drawable/ic_browser_ai"
                    android:contentDescription="AI ব্রাউজার মোড" />

                <!-- Discussion-mode toggle (sibling of browser mode, same
                     spot): when ON, messages still get answered —
                     database search first if relevant, otherwise a
                     normal reply — but the server never turns the reply
                     into an actual workflow card, only a suggestion. -->
                <ImageButton
                    android:id="@+id/discussionModeButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="7dp"
                    android:src="@drawable/ic_discussion"
                    android:contentDescription="@string/cd_discussion_mode" />

                <!-- AI Learning Mode: opens a full-screen teaching
                     experience (LearningModeActivity) instead of sending
                     a normal chat message — not a toggle like the two
                     buttons above, tapping it always launches the
                     screen directly. -->
                <ImageButton
                    android:id="@+id/learningModeButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="7dp"
                    android:src="@drawable/ic_learning_mode"
                    android:contentDescription="AI লার্নিং মোড" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/micButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="7dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Voice command" />

                <ImageButton
                    android:id="@+id/sendButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_icon_active"
                    android:padding="10dp"
                    android:src="@drawable/ic_send"
                    android:contentDescription="@string/chat_send" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include
        layout="@layout/overlay_voice_first"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
