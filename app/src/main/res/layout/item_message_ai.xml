<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <TextView
        android:id="@+id/messageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_bubble_ai"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_primary_light"
        android:textSize="15sp" />

    <!-- ELA 4N only: small "which sites" chip row (Perplexity-style source
         pills), built up in ChatAdapter from result.sources — empty/GONE
         for every other system, so this is a no-op for ela_1st/super_1_2/
         super_lite bubbles. -->
    <HorizontalScrollView
        android:id="@+id/sourcesScroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="60dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sourcesRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Gemini-style action row under the reply: copy, regenerate, report.
         No like/dislike — not needed here. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp">

        <ImageView
            android:id="@+id/copyButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_copy"
            android:tint="@color/text_muted_light"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_copy_message"
            android:alpha="0.55" />

        <ImageView
            android:id="@+id/retryButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_retry"
            android:tint="@color/text_muted_light"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_retry_message"
            android:alpha="0.55" />

        <ImageView
            android:id="@+id/reportButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_report_flag"
            android:tint="@color/text_muted_light"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_report_message"
            android:alpha="0.55" />
    </LinearLayout>
</LinearLayout>
