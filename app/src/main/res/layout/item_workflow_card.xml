<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginEnd="40dp"
    android:padding="14dp"
    android:background="@drawable/bg_workflow_card">

    <TextView
        android:id="@+id/workflowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary_light"
        android:textStyle="bold"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/workflowStepsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_secondary_light"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/workflowStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/primary_action"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/workflowRunButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="end"
        android:background="@drawable/bg_button_primary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/workflow_run"
        android:textAllCaps="false"
        android:textColor="@color/white" />
</LinearLayout>
