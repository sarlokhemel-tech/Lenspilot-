<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginEnd="40dp"
    android:padding="14dp"
    android:background="@drawable/bg_workflow_card">

    <TextView
        android:id="@+id/lessonLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ক্লাস"
        android:textColor="@color/primary_action"
        android:textStyle="bold"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/lessonTopic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_primary_light"
        android:textStyle="bold"
        android:textSize="15sp" />

    <!-- Deliberately no steps/outline here — per spec, how the topic will
         be taught is decided freely by the compose model at Run time and
         only shown inside the full-screen lesson, behind its own
         "outline" toggle. -->

    <Button
        android:id="@+id/lessonRunButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="end"
        android:background="@drawable/bg_button_primary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="Run"
        android:textAllCaps="false"
        android:textColor="@color/white" />
</LinearLayout>
