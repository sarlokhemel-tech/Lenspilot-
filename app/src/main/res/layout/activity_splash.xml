<?xml version="1.0" encoding="utf-8"?>
<!-- v37: ঢোকার ছবি = নতুন LensPilot লোগো (ট্যাগলাইনসহ ছবির ভেতরেই); ছবির ব্যাকগ্রাউন্ড সাদা, তাই পুরো স্ক্রিন সাদা -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_centerInParent="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_splash_logo"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="14dp"
            android:layout_height="1dp"
            android:background="@color/border_light"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_credit"
            android:textColor="@color/text_muted_light"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="14dp"
            android:layout_height="1dp"
            android:background="@color/border_light"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</RelativeLayout>
