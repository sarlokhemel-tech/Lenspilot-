<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Top control bar — mirrors the small "Gemini-style" pill the
         chat input row uses, kept intentionally tiny per spec ("শুধু
         ওইটুকু" — just that much, nothing more elaborate). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_light"
        android:paddingStart="6dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/browserCloseButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:contentDescription="বন্ধ করো" />

        <TextView
            android:id="@+id/browserStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text_primary_light"
            android:textSize="13sp"
            android:text="ম্যানুয়াল মোড — নিজে ব্রাউজ করুন" />

        <TextView
            android:id="@+id/browserAiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="AI"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/navigation" />

        <Switch
            android:id="@+id/browserAiSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="AI অটোমেশন চালু/বন্ধ" />
    </LinearLayout>

    <!-- Goal input row — only visible when AI mode is ON but no task is
         currently running (fresh open, or after task_complete/ask_user).
         Same three actions the user described: খুঁজে দাও (search),
         চালু করো (open/play), ইত্যাদি — free text, sent as `goal`. -->
    <LinearLayout
        android:id="@+id/browserGoalRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_light"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/browserGoalInput"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="কী করতে চাও লেখো… (যেমন: Arijit Singh এর Tum Hi Ho চালু করো)"
            android:textColor="@color/text_primary_light"
            android:textColorHint="@color/text_muted_light"
            android:textSize="13sp"
            android:maxLines="1"
            android:imeOptions="actionGo"
            android:inputType="text" />

        <ImageButton
            android:id="@+id/browserGoalGoButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_icon_active"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            android:contentDescription="শুরু করো" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/browserProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/navigation"
        android:visibility="gone" />

    <WebView
        android:id="@+id/aiWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
