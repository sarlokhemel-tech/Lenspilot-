<?xml version="1.0" encoding="utf-8"?>
<!-- v74: "এই কাজের তথ্য" বক্স — আগে অটোমেশন ব্রাউজার স্ক্রিনের নিচে বড় প্যানেল ছিল, এখন ছোট আইকনে চাপলে এই ডায়ালগে খোলে -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/browserInfoDialogRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Information for this task"
                    android:textColor="@color/auto_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/browserDbCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_auto_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="0 items"
                    android:textColor="@color/auto_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/browserDbInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auto_input"
                android:gravity="top|start"
                android:hint="One item per line"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:minLines="2"
                android:padding="10dp"
                android:textColor="@color/auto_text"
                android:textColorHint="@color/auto_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/browserDbStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/auto_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/browserDbSaveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_auto_chip"
                    android:gravity="center"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="Add"
                    android:textColor="@color/auto_accent"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/browserDbPhotoButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_auto_chip"
                    android:gravity="center"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="Get from image"
                    android:textColor="@color/auto_accent"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/browserDbViewButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_auto_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="List"
                    android:textColor="@color/auto_accent"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/browserVaultButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_auto_chip"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="Vault"
                    android:textColor="@color/auto_accent"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
