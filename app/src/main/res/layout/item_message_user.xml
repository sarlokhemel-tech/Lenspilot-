<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <ImageView
        android:id="@+id/messageImage"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginStart="60dp"
        android:layout_marginBottom="4dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_bubble_user"
        android:visibility="gone"
        android:contentDescription="Attached screenshot" />

    <TextView
        android:id="@+id/messageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:background="@drawable/bg_bubble_user"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <!-- Resend this exact message — drops whatever reply followed it and
         asks the AI again, e.g. after a failed/unwanted reply. -->
    <ImageView
        android:id="@+id/retryUserButton"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:padding="5dp"
        android:src="@drawable/ic_retry"
        android:tint="@color/text_muted_light"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_retry_user_message"
        android:alpha="0.55" />
</LinearLayout>
