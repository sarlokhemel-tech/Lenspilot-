<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:contentDescription="বন্ধ করো"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />

        <!-- আকর্ষণীয় প্রোমো ব্লক -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🚀 ফ্রিমিয়াম আনলক করো"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="নিজের Gemini API কী যোগ করে পাও — কম বিজ্ঞাপন আর আনলিমিটেড ফ্রি ব্যবহার! কোনো টাকা লাগবে না, Google নিজেই ফ্রিতে দেয়।"
            android:textColor="#CBD5E1"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartGuide"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2563EB"
            android:text="✨ কম এড এবং আনলিমিটেড ফ্রি ব্যবহার করতে নিচে ক্লিক করুন"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:cornerRadius="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="অথবা — আগে থেকেই কী থাকলে সরাসরি বসাও"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E293B"
            android:hint="AIza... দিয়ে শুরু তোমার Gemini API কী"
            android:textColorHint="#64748B"
            android:inputType="text"
            android:padding="16dp"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActivateDirect"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="সরাসরি বসিয়ে চালু করো"
            android:textAllCaps="false"
            app:cornerRadius="16dp"
            app:strokeColor="#2563EB" />

    </LinearLayout>
</ScrollView>
