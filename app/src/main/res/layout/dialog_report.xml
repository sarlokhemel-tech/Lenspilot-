<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/reportedMessageLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/report_reported_message_label"
        android:textColor="@color/text_secondary_light"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <TextView
        android:id="@+id/reportedMessageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bubble_ai"
        android:padding="12dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:textColor="@color/text_secondary_light"
        android:textSize="13sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/reportDescriptionInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="4"
        android:gravity="top|start"
        android:background="@drawable/bg_bubble_ai"
        android:padding="12dp"
        android:hint="@string/report_description_hint"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_muted_light"
        android:textSize="14sp"
        android:inputType="textMultiLine|textCapSentences" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/attachScreenshotButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_attach_screenshot"
            android:textColor="@color/primary_action"
            android:textAllCaps="false"
            android:paddingStart="0dp" />

        <ImageView
            android:id="@+id/reportScreenshotThumb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/removeScreenshotButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_remove_screenshot"
            android:textColor="@color/danger_destructive"
            android:textSize="13sp"
            android:visibility="gone"
            android:padding="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/reportStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
</ScrollView>
