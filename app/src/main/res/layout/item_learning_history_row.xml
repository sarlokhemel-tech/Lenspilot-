<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_blackboard_circle"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_history"
        android:tint="@color/chalk_white" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lhRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/chalk_white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/lhRowSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chalk_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lhRowTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/chalk_muted"
        android:textSize="11sp" />

    <ImageButton
        android:id="@+id/lhRowDelete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@null"
        android:contentDescription="Delete"
        android:padding="8dp"
        android:src="@drawable/ic_close_white"
        android:tint="@color/chalk_muted" />
</LinearLayout>
