<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_auto_speak_title"
                android:textColor="@color/text_primary_light"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/setting_auto_speak_desc"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/autoSpeakSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- "App খুললেই ভয়েস কমান্ড" moved out of here — it's now the
         icon-only button at the very top of the chat screen (next to
         history), so it's reachable without opening this dialog. -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/border_light" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/setting_screen_guide_mode_title"
        android:textColor="@color/text_primary_light"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:text="@string/setting_screen_guide_mode_desc"
        android:textColor="@color/text_secondary_light"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/screenGuideModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- v24: ডিফল্ট — স্ক্রিনশটই মূল উৎস (Gemini/Groq vision), accessibility tree লাগে না -->
        <RadioButton
            android:id="@+id/screenGuideModeVision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_screen_guide_mode_vision"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <RadioButton
            android:id="@+id/screenGuideModeAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_screen_guide_mode_accessibility"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <RadioButton
            android:id="@+id/screenGuideModeVlm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_screen_guide_mode_vlm"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <RadioButton
            android:id="@+id/screenGuideModeYolo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_screen_guide_mode_yolo"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <RadioButton
            android:id="@+id/screenGuideModeOcr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_screen_guide_mode_ocr"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- New: YOLO + OCR combined ("হাইব্রিড") — see
             Prefs.SCREEN_GUIDE_MODE_HYBRID's doc comment for exactly what
             "stronger" means here (lower detector threshold + both
             readings kept for the same region instead of deduping). -->
        <RadioButton
            android:id="@+id/screenGuideModeHybrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_screen_guide_mode_hybrid"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/border_light" />

    <!-- v24: Vision ছবির মান। ডিফল্ট = সাদাকালো + সামান্য কম রেজুলেশন (দ্রুত, কম টোকেন) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/setting_vision_quality_title"
        android:textColor="@color/text_primary_light"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:text="@string/setting_vision_quality_desc"
        android:textColor="@color/text_secondary_light"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="12dp"
            android:text="@string/setting_vision_color"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp" />
        <Switch
            android:id="@+id/visionColorSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/visionResolutionGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RadioButton
            android:id="@+id/visionResTiny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_vision_res_tiny"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
        <RadioButton
            android:id="@+id/visionResLow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_vision_res_low"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
        <RadioButton
            android:id="@+id/visionResMid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_vision_res_mid"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
        <RadioButton
            android:id="@+id/visionResFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_vision_res_full"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="12dp"
            android:text="@string/setting_vision_auto_boost"
            android:textColor="@color/text_primary_light"
            android:textSize="13sp" />
        <Switch
            android:id="@+id/visionAutoBoostSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/border_light" />

    <LinearLayout
        android:id="@+id/supportReportRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_support_report_title"
                android:textColor="@color/text_primary_light"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/setting_support_report_desc"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_secondary_light" />
    </LinearLayout>

    <!-- Developer/debug view only — shows the on-device "RAM-style" scratch
         log an AI task was using (see ContextWindowStore.kt). Not something
         an ordinary user needs; kept here purely so it's easy to confirm
         the mechanism is actually running. -->
    <LinearLayout
        android:id="@+id/contextWindowRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_context_window_title"
                android:textColor="@color/text_primary_light"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/setting_context_window_desc"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_secondary_light" />
    </LinearLayout>

</LinearLayout>
