<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp">

    <ImageButton
        android:id="@+id/adBreakCloseButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="end|top"
        android:background="@drawable/bg_circle_icon"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/ad_break_stop" />

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_token"
        android:contentDescription="@string/get_tokens_button" />

    <TextView
        android:id="@+id/adBreakTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/get_tokens_button"
        android:textColor="@color/text_primary_light"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Balance card — the two numbers here are what animate (count-up)
         right after a rewarded ad's onEarnedReward fires. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_workflow_card"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/adBreakInputValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/primary_action"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tokens_input_label"
                android:textColor="@color/text_muted_light"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/adBreakOutputValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/input_field"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tokens_output_label"
                android:textColor="@color/text_muted_light"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/adBreakRewardPreviewText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_secondary_light"
        android:textSize="13sp"
        android:gravity="center" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/adBreakWatchButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_button_primary"
        android:text="@string/token_limit_watch_ad"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adBreakWatchedCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_muted_light"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ad_break_suggestion"
        android:textColor="@color/text_muted_light"
        android:textSize="11sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/adBreakStopButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="8dp"
        android:text="@string/ad_break_stop"
        android:textColor="@color/text_secondary_light"
        android:textSize="14sp" />

</LinearLayout>
