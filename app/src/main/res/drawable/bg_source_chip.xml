<?xml version="1.0" encoding="utf-8"?>
<!-- Small rounded "which site" pill shown under an ELA 4N reply (see
     ChatAdapter's sourcesRow) — Perplexity-style source chips, listing the
     sites the live search actually drew from. Not used by any other
     system/bubble type. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#EEF2F7" />
    <stroke android:width="1dp" android:color="@color/border_light" />
    <corners android:radius="14dp" />
</shape>
