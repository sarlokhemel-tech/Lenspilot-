    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Target ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:pathData="M54,34 A20,20 0 1,1 53.9,34 Z" />

    <!-- Pointer/cursor tapping the target -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M60,52 L82,59.5 L72,64.2 L78.5,76 L72,79.5 L65.5,67.7 L58.5,75 Z" />

    <!-- Center dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-5.5,0 a5.5,5.5 0 1,1 11,0 a5.5,5.5 0 1,1 -11,0" />
</vector>
