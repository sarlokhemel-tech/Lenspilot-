<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F7F2E6" />
            <stroke android:width="1dp" android:color="@color/bb_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:width="3dp" android:left="12dp" android:top="10dp" android:bottom="10dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/bb_gold" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
