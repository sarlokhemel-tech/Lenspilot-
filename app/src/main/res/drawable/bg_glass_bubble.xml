<?xml version="1.0" encoding="utf-8"?>
<!-- Small floating trigger bubble — tap to re-read the current screen and
     get guidance, replacing the old always-on auto-read loop. Deliberately
     smaller than a typical chat-head bubble. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#E6FFFFFF" />
    <stroke android:width="1.5dp" android:color="@color/primary_action" />
</shape>
